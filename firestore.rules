rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidExpense(data) {
      return data.keys().hasAll(['userId', 'date', 'amount', 'description', 'category', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'date', 'amount', 'description', 'category', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.amount is number && data.amount > 0
        && data.description is string && data.description.size() > 0 && data.description.size() <= 200
        && data.category in ['makanan', 'transportasi', 'kebutuhan', 'pendidikan', 'operasional', 'lainnya']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidIncome(data) {
      return data.keys().hasAll(['userId', 'date', 'amount', 'description', 'category', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['userId', 'date', 'amount', 'description', 'category', 'createdAt', 'updatedAt'])
        && data.userId is string && data.userId == request.auth.uid
        && data.date is string && data.date.size() == 10 && data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && data.amount is number && data.amount > 0
        && data.description is string && data.description.size() > 0 && data.description.size() <= 200
        && data.category in ['gaji', 'bisnis', 'investasi', 'hadiah', 'freelance', 'lainnya']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /expenses/{expenseId} {
      allow get: if isSignedIn() && isValidId(expenseId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(expenseId)
        && isValidExpense(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'amount', 'description', 'category', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(expenseId)
        && existing().userId == request.auth.uid;
    }

    match /incomes/{incomeId} {
      allow get: if isSignedIn() && isValidId(incomeId) && existing().userId == request.auth.uid;
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn()
        && isValidId(incomeId)
        && isValidIncome(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isSignedIn()
        && isValidId(incomeId)
        && isValidIncome(incoming())
        && existing().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['date', 'amount', 'description', 'category', 'updatedAt']);

      allow delete: if isSignedIn()
        && isValidId(incomeId)
        && existing().userId == request.auth.uid;
    }

    match /test/{testId} {
      allow read: if isSignedIn();
    }
  }
}
